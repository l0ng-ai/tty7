# Git detects binary content on its own, but the bundled ConPTY is redistributed
# byte-for-byte from Microsoft and checked against its own file version at
# release time. Say so explicitly so no future line-ending rule can rewrite it.
assets/windows/conpty/**/*.dll binary
assets/windows/conpty/**/*.exe binary

# include_str! fixtures are compared byte-for-byte; autocrlf would add \r on Windows.
src/terminal/view/fixtures/*.txt -text

# The Material icon pack is vendored byte-for-byte from upstream; an autocrlf
# rewrite would make every re-sync a diff over all 1,251 files.
assets/icons/material/** -text
